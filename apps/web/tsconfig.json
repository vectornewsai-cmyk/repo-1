{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "exclude": [
    "src/lib/assetStore.test.ts",
    "src/lib/captionFollow.test.ts",
    "src/lib/clipboard.test.ts",
    "src/lib/projectHistory.test.ts",
    "src/lib/sharePage.test.ts",
    "src/lib/silenceFollow.test.ts",
    "src/lib/syncProtocol.test.ts",
    "src/lib/beatSync.test.ts"
  ]
}
