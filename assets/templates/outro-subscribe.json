{
  "template": {
    "id": "outro-subscribe",
    "name": "Kết video kêu gọi đăng ký",
    "description": "Video ngang kết: cảm ơn + nút đăng ký + video tiếp theo.",
    "category": "outro",
    "version": "1.0.0",
    "author": "VCut Studio",
    "license": "MIT",
    "tags": [
      "outro",
      "đăng ký",
      "ngang"
    ],
    "aspect": "1920:1080",
    "durationSec": 5.5,
    "placeholders": [
      {
        "id": "thanks",
        "kind": "text",
        "label": "Lời cảm ơn",
        "default": "CẢM ƠN BẠN ĐÃ XEM!"
      },
      {
        "id": "subscribe",
        "kind": "text",
        "label": "Kêu gọi đăng ký",
        "default": "NHẤN ĐĂNG KÝ ĐỂ KHÔNG BỎ LỠ VIDEO MỚI"
      },
      {
        "id": "next",
        "kind": "text",
        "label": "Video tiếp theo",
        "default": "TIẾP THEO: HÀNH TRÌNH 30 NGÀY"
      }
    ]
  },
  "spec": {
    "version": "0.2.0",
    "meta": {
      "name": "Kết video kêu gọi đăng ký",
      "width": 1920,
      "height": 1080,
      "fps": 30
    },
    "tracks": [
      {
        "id": "t1",
        "kind": "text",
        "label": "Cảm ơn",
        "clips": [
          {
            "kind": "text",
            "id": "t1",
            "text": "{{thanks}}",
            "start": 0.5,
            "duration": 5.0,
            "style": {
              "fontFamily": "Be Vietnam Pro",
              "fontSize": 64,
              "color": "#ffffff",
              "x": 0.5,
              "y": 0.3,
              "animation": "popIn",
              "bold": true,
              "italic": false
            }
          }
        ]
      },
      {
        "id": "t2",
        "kind": "text",
        "label": "Đăng ký",
        "clips": [
          {
            "kind": "text",
            "id": "t2",
            "text": "{{subscribe}}",
            "start": 1.5,
            "duration": 4.0,
            "style": {
              "fontFamily": "Be Vietnam Pro",
              "fontSize": 40,
              "color": "#FCA5A5",
              "x": 0.5,
              "y": 0.55,
              "animation": "fadeUp",
              "bold": true,
              "italic": false
            }
          }
        ]
      },
      {
        "id": "t3",
        "kind": "text",
        "label": "Tiếp theo",
        "clips": [
          {
            "kind": "text",
            "id": "t3",
            "text": "{{next}}",
            "start": 2.5,
            "duration": 3.0,
            "style": {
              "fontFamily": "Be Vietnam Pro",
              "fontSize": 34,
              "color": "#BFDBFE",
              "x": 0.5,
              "y": 0.75,
              "animation": "fadeIn",
              "bold": true,
              "italic": false
            }
          }
        ]
      }
    ]
  }
}