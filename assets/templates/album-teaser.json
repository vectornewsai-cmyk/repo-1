{
  "template": {
    "id": "album-teaser",
    "name": "Teaser album",
    "description": "Ảnh bìa vuông + tên album + ngày phát hành.",
    "category": "music",
    "version": "1.0.0",
    "author": "VCut Studio",
    "license": "MIT",
    "tags": [
      "album",
      "teaser",
      "âm nhạc",
      "vuông"
    ],
    "aspect": "1080:1080",
    "durationSec": 8,
    "placeholders": [
      {
        "id": "cover",
        "kind": "image",
        "label": "Ảnh bìa",
        "default": "album-cover.jpg"
      },
      {
        "id": "album",
        "kind": "text",
        "label": "Tên album",
        "default": "MÙA HÈ KHÔNG TÊN"
      },
      {
        "id": "release",
        "kind": "text",
        "label": "Ngày phát hành",
        "default": "Ra mắt 01.06.2027"
      }
    ]
  },
  "spec": {
    "version": "0.2.0",
    "meta": {
      "name": "Teaser album",
      "width": 1080,
      "height": 1080,
      "fps": 30
    },
    "tracks": [
      {
        "id": "i1",
        "kind": "image",
        "label": "Bìa",
        "clips": [
          {
            "kind": "image",
            "id": "i1",
            "src": "{{cover}}",
            "start": 0,
            "duration": 8,
            "fit": "cover"
          }
        ]
      },
      {
        "id": "t1",
        "kind": "text",
        "label": "Tên album",
        "clips": [
          {
            "kind": "text",
            "id": "t1",
            "text": "{{album}}",
            "start": 0.5,
            "duration": 7.0,
            "style": {
              "fontFamily": "Be Vietnam Pro",
              "fontSize": 60,
              "color": "#ffffff",
              "x": 0.5,
              "y": 0.8,
              "animation": "fadeUp",
              "bold": true,
              "italic": false,
              "backgroundColor": "#000000"
            }
          }
        ]
      },
      {
        "id": "t2",
        "kind": "text",
        "label": "Ngày phát hành",
        "clips": [
          {
            "kind": "text",
            "id": "t2",
            "text": "{{release}}",
            "start": 1.5,
            "duration": 6.0,
            "style": {
              "fontFamily": "Be Vietnam Pro",
              "fontSize": 36,
              "color": "#FDE68A",
              "x": 0.5,
              "y": 0.9,
              "animation": "fadeIn",
              "bold": true,
              "italic": false
            }
          }
        ]
      }
    ]
  }
}