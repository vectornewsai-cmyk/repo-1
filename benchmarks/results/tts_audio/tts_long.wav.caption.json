      "text": "Chí tội nhân tạo đang thay đổi cách con người"
    },
    {
      "start": 1.74,
      "end": 2.42,
      "text": "làm việc mỗi ngày."
    },
    {
      "start": 2.9,
      "end": 5.28,
      "text": "Từ việc viết văn bản, vẽ tranh, sáng tác nhạc"
    },
    {
      "start": 5.28,
      "end": 7.62,
      "text": "cho đến dựng video, các công cụ mới giúp giúp"
    },
    {
      "start": 7.62,
      "end": 9.32,
      "text": "ngắn thời gian sản xuất từ nhiều giờ xuống"
