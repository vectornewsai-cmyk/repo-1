      "end": 9.86,
      "text": "còn vài phút."
    },
    {
      "start": 10.32,
      "end": 12.06,
      "text": "Tuy nhiên, yếu tố quan trọng nhất vẫn là ý"
    },
    {
      "start": 12.06,
      "end": 14.36,
      "text": "tưởng và sự sáng tạo của con người, bởi công"
    },
    {
      "start": 14.36,
      "end": 16.78,
      "text": "nghệ chỉ là công cụ hỗ trợ, không thể thay"
    },
    {
      "start": 16.78,
      "end": 18.14,
      "text": "thế hoàn toàn tư duy nghệ thuật."
    }
